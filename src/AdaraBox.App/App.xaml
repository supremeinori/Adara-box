<Application x:Class="AdaraBox.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Core Color Palette -->
            <SolidColorBrush x:Key="BarBackgroundBrush" Color="#EE1E1E24" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FA18181B" />
            <SolidColorBrush x:Key="BarBorderBrush" Color="#3F3F46" />
            <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A" />

            <!-- Module Status Colors -->
            <SolidColorBrush x:Key="StatusAvailableBrush" Color="#10B981" />
            <SolidColorBrush x:Key="StatusInDevBadgeBackgroundBrush" Color="#3B2E05" />
            <SolidColorBrush x:Key="StatusInDevBadgeBorderBrush" Color="#D97706" />
            <SolidColorBrush x:Key="StatusInDevTextBrush" Color="#FBBF24" />

            <SolidColorBrush x:Key="StatusErrorBadgeBackgroundBrush" Color="#450A0A" />
            <SolidColorBrush x:Key="StatusErrorBadgeBorderBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="StatusErrorTextBrush" Color="#F87171" />

            <!-- Default Text Font -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
