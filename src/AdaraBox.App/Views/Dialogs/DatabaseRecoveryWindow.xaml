<Window x:Class="AdaraBox.App.Views.Dialogs.DatabaseRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pemulihan Database — Adara Box"
        Width="520" Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Background="#18181B"
        Foreground="#F4F4F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="⚠️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="Masalah Database Terdeteksi" FontSize="16" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center" />
            </StackPanel>
            <Border Background="#2B1D1D" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="6" Padding="12,10">
                <TextBlock x:Name="ErrorMessageTextBlock" Text="Terjadi kesalahan saat memeriksa file database." FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Backups List (if available) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Backup Tersedia:" FontSize="12" FontWeight="SemiBold" Foreground="#D4D4D8" Margin="0,0,0,6" />
            <ListBox x:Name="BackupsListBox"
                     Height="120"
                     Background="#202025"
                     BorderBrush="#3F3F46"
                     Foreground="#F4F4F5"
                     FontSize="11"
                     Padding="4" />
            <TextBlock x:Name="NoBackupWarningTextBlock"
                       Text="Tidak ditemukan backup otomatis sebelumnya."
                       FontSize="11"
                       Foreground="#71717A"
                       Margin="0,4,0,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- Action Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Explorer Button -->
            <Button Grid.Column="0"
                    x:Name="OpenFolderButton"
                    Content="📁 Buka Folder Data"
                    Click="OpenFolderButton_Click"
                    Background="#27272A"
                    Foreground="#D4D4D8"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    Padding="10,6"
                    FontSize="11"
                    Cursor="Hand" />

            <!-- Main Recovery Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="RestoreBackupButton"
                        Content="Pulihkan Backup"
                        Click="RestoreBackupButton_Click"
                        Background="#059669"
                        Foreground="#FFFFFF"
                        BorderBrush="#10B981"
                        BorderThickness="1"
                        Padding="12,6"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,8,0" />

                <Button x:Name="StartFreshButton"
                        Content="Mulai Database Baru"
                        Click="StartFreshButton_Click"
                        Background="#2563EB"
                        Foreground="#FFFFFF"
                        BorderBrush="#3B82F6"
                        BorderThickness="1"
                        Padding="12,6"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Margin="0,0,8,0" />

                <Button x:Name="ExitButton"
                        Content="Keluar"
                        Click="ExitButton_Click"
                        Background="#3F3F46"
                        Foreground="#F4F4F5"
                        BorderThickness="0"
                        Padding="12,6"
                        FontSize="11"
                        Cursor="Hand" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
