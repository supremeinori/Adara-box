<UserControl x:Class="AdaraBox.App.Views.Panels.MediaPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:AdaraBox.App.Converters"
             xmlns:vm="clr-namespace:AdaraBox.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:MediaPanelViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="480" d:DesignWidth="460">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />

        <!-- Apple Style Primary Action Button -->
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#E4E4E7" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F4F4F5" />
                                <Setter Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E4E4E7" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E1E24" />
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#33333E" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A34" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="BorderBrush" Value="#4B4B58" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Media Playback Control Button -->
        <Style x:Key="MediaControlBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#22222A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#383846" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E2E3A" />
                                <Setter Property="BorderBrush" Value="#555568" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Secondary Playback Button -->
        <Style x:Key="CompactMediaBtnStyle" TargetType="Button" BasedOn="{StaticResource MediaControlBtnStyle}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <!-- Launch Button Style -->
        <Style x:Key="LaunchBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#202026" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#33333E" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFFFFF" />
                                <Setter Property="Foreground" Value="#000000" />
                                <Setter Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10" MinWidth="430">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header Row -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🎵" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="Media &amp; Playback" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="+ Tautan Web"
                    Command="{Binding BeginAddCommand}"
                    Style="{StaticResource PrimaryActionBtnStyle}"
                    Visibility="{Binding IsFormOpen, Converter={StaticResource InverseBoolToVis}}" />
        </Grid>

        <!-- 2. Multi-Session Media Section (Apple Neomorphism) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">

            <!-- Primary / Top Session Card -->
            <Border Background="#18181D"
                    BorderBrush="#2A2A34"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Track Info -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <!-- Platform Badge -->
                            <TextBlock Text="{Binding PrimarySession.PlatformIcon}" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"
                                       Visibility="{Binding HasActiveSessions, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding PrimarySession.PlatformDisplayName}"
                                       Foreground="{Binding PrimarySession.PlatformBadgeColor}"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Visibility="{Binding HasActiveSessions, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="● Utama (On-Top)" FontSize="9" FontWeight="SemiBold" Foreground="#8E8E93" VerticalAlignment="Center"
                                       Visibility="{Binding HasActiveSessions, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="● Tidak Ada Media" FontSize="10" FontWeight="SemiBold" Foreground="#71717A" VerticalAlignment="Center"
                                       Visibility="{Binding HasActiveSessions, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding TrackTitle}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding TrackArtist}"
                                   FontSize="11"
                                   Foreground="#A1A1AA"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,1,0,0" />
                    </StackPanel>

                    <!-- Primary Transport Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⏮"
                                Command="{Binding PreviousTrackCommand}"
                                Style="{StaticResource MediaControlBtnStyle}"
                                ToolTip="Lagu Sebelumnya"
                                Margin="0,0,4,0" />
                        <Button Content="{Binding PlayPauseButtonText}"
                                Command="{Binding PlayPauseCommand}"
                                Style="{StaticResource MediaControlBtnStyle}"
                                ToolTip="Putar / Jeda"
                                Margin="0,0,4,0" />
                        <Button Content="⏭"
                                Command="{Binding NextTrackCommand}"
                                Style="{StaticResource MediaControlBtnStyle}"
                                ToolTip="Lagu Berikutnya" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Collapsible Multi-Session Header & Toggle Bar (Visible if >1 active session) -->
            <Grid Margin="0,6,0,4"
                  Visibility="{Binding HasMultipleSessions, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sesi Aktif Lainnya" FontSize="10" FontWeight="SemiBold" Foreground="#8E8E93" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Show More / Show Less Toggle Button -->
                <Button Grid.Column="1"
                        Content="{Binding CollapseButtonText}"
                        Command="{Binding ToggleCollapseCommand}"
                        Style="{StaticResource SecondaryActionBtnStyle}"
                        ToolTip="Tampilkan atau ciutkan sesi media lainnya" />
            </Grid>

            <!-- Collapsible Secondary Sessions List -->
            <ItemsControl ItemsSource="{Binding SecondarySessions}"
                          Visibility="{Binding IsSecondarySessionsVisible, Converter={StaticResource BoolToVis}}"
                          Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MediaSessionItemViewModel}">
                        <Border Background="#141418"
                                BorderBrush="#252530"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10,6"
                                Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Session Title & Platform -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                                        <TextBlock Text="{Binding PlatformIcon}" FontSize="9" Margin="0,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PlatformDisplayName}"
                                                   Foreground="{Binding PlatformBadgeColor}"
                                                   FontSize="9" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#E4E4E7"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artist}"
                                               FontSize="10"
                                               Foreground="#8E8E93"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Per-Session Independent Controls -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Set as Top/Primary Button -->
                                    <Button Content="⬆ Jadikan Utama"
                                            Command="{Binding MakeTopCommand}"
                                            Style="{StaticResource SecondaryActionBtnStyle}"
                                            ToolTip="Jadikan sesi ini di posisi paling atas"
                                            Margin="0,0,4,0" />

                                    <!-- Independent Play/Pause Button -->
                                    <Button Content="{Binding PlayPauseButtonText}"
                                            Command="{Binding TogglePlayPauseCommand}"
                                            Style="{StaticResource CompactMediaBtnStyle}"
                                            ToolTip="Putar atau jeda sesi ini" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 3. Content Area (Web Links / Form) -->
        <Grid Grid.Row="2">

            <!-- A. INLINE FORM (Add Media Link) -->
            <Border Background="#1C1C22"
                    BorderBrush="#383846"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    VerticalAlignment="Top"
                    Panel.ZIndex="100"
                    Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#F4F4F5" Margin="0,0,0,8" />

                    <TextBlock Text="Nama Layanan (misal: Spotify, YouTube Music, Podcast):" FontSize="11" Foreground="#8E8E93" Margin="0,0,0,3" />
                    <TextBox x:Name="FormNameTextBox"
                             Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                             Background="#141418" Foreground="#F4F4F5" BorderBrush="#2C2C36" BorderThickness="1"
                             Padding="7,5" FontSize="11" MaxLength="60" Margin="0,0,0,8"
                             KeyDown="FormTextBox_KeyDown"
                             IsVisibleChanged="FormNameTextBox_IsVisibleChanged" />

                    <TextBlock Text="URL Web (harus diawali http:// atau https://):" FontSize="11" Foreground="#8E8E93" Margin="0,0,0,3" />
                    <TextBox x:Name="FormUrlTextBox"
                             Text="{Binding FormUrl, UpdateSourceTrigger=PropertyChanged}"
                             Background="#141418" Foreground="#F4F4F5" BorderBrush="#2C2C36" BorderThickness="1"
                             Padding="7,5" FontSize="11" Margin="0,0,0,6"
                             KeyDown="FormTextBox_KeyDown" />

                    <TextBlock Text="{Binding FormError}" Foreground="#FCA5A5" FontSize="11" Margin="2,3,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasFormError, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Batal (Esc)" Command="{Binding CancelFormCommand}" Style="{StaticResource SecondaryActionBtnStyle}" Margin="0,0,6,0" />
                        <Button Content="Simpan (Enter)" Command="{Binding SaveFormCommand}" Style="{StaticResource PrimaryActionBtnStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- B. MEDIA QUICK LINKS LIST -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250"
                          Visibility="{Binding IsFormOpen, Converter={StaticResource InverseBoolToVis}}">
                <Grid>
                    <!-- Empty State -->
                    <Border Background="#18181D"
                            BorderBrush="#2A2A34"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="22"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🎵" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding EmptyTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EmptyDescription}" FontSize="11" Foreground="#8E8E93" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,12" MaxWidth="300" HorizontalAlignment="Center" />
                            <Button Content="+ Tambah Tautan Web Pertama" Command="{Binding BeginAddCommand}" Style="{StaticResource PrimaryActionBtnStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Links Cards -->
                    <ItemsControl ItemsSource="{Binding Links}"
                                  Visibility="{Binding HasLinks, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MediaLinkItemViewModel}">
                                <Border Background="#18181D"
                                        BorderBrush="#2A2A34"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="10,6"
                                        Margin="0,0,0,5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#202026" />
                                                    <Setter Property="BorderBrush" Value="#444452" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Link Title & URL -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Url}" FontSize="10" Foreground="#8E8E93" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Buka ↗"
                                                    Command="{Binding LaunchCommand}"
                                                    Style="{StaticResource LaunchBtnStyle}"
                                                    ToolTip="Buka di browser bawaan"
                                                    Margin="0,0,5,0" />
                                            <Button Content="🗑"
                                                    Command="{Binding DeleteCommand}"
                                                    Style="{StaticResource SecondaryActionBtnStyle}"
                                                    ToolTip="Hapus tautan ini"
                                                    Padding="6,3" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
