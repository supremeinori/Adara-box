<UserControl x:Class="AdaraBox.App.Views.Panels.WorkspacePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AdaraBox.App.ViewModels"
             xmlns:conv="clr-namespace:AdaraBox.App.Converters"
             d:DataContext="{d:DesignInstance vm:WorkspacePanelViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="380" d:DesignWidth="440">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />

        <!-- Base Primary Button Style -->
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8" />
                                <Setter Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F3F46" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Destructive Button Style -->
        <Style x:Key="DestructiveActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#3F1D1D" />
            <Setter Property="Foreground" Value="#F87171" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#7F1D1D" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#991B1B" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="BorderBrush" Value="#DC2626" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16" MinWidth="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- HEADER ROW                                  -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <!-- Normal List Header (When not in detail view) -->
            <Grid Visibility="{Binding IsDetailViewActive, Converter={StaticResource InverseBoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Workspace" FontSize="14" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Buat Workspace"
                        Command="{Binding BeginCreateCommand}"
                        Style="{StaticResource PrimaryActionBtnStyle}"
                        Visibility="{Binding IsFormOpen, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>

            <!-- Detail View Header (When viewing a specific workspace) -->
            <Grid Visibility="{Binding IsDetailViewActive, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0"
                        Content="← Kembali"
                        Command="{Binding BackToListCommand}"
                        Style="{StaticResource SecondaryActionBtnStyle}"
                        Margin="0,0,12,0" />

                <!-- Detail Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DetailTitle}" FontSize="15" FontWeight="Bold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DetailResourceCountText}" FontSize="11" Foreground="#71717A" Margin="0,1,0,0" />
                </StackPanel>

                <!-- Actions: Rename & Delete -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsFormOpen, Converter={StaticResource InverseBoolToVis}}">
                    <Button Content="Ganti Nama"
                            Command="{Binding BeginRenameCommand}"
                            CommandParameter="{Binding SelectedWorkspace}"
                            Style="{StaticResource SecondaryActionBtnStyle}"
                            Margin="0,0,6,0" />
                    <Button Content="Hapus"
                            Command="{Binding DeleteWorkspaceCommand}"
                            CommandParameter="{Binding SelectedWorkspace}"
                            Style="{StaticResource DestructiveActionBtnStyle}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- CONTENT AREA (ROW 1)                       -->
        <!-- ========================================== -->
        <Grid Grid.Row="1">

            <!-- 1. INLINE FORM (Create / Rename) -->
            <Border Background="#202025"
                    BorderBrush="#3B82F6"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    VerticalAlignment="Top"
                    Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#F4F4F5"
                               Margin="0,0,0,10" />

                    <!-- Name Input -->
                    <TextBox x:Name="FormNameTextBox"
                             Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                             Background="#18181B"
                             Foreground="#F4F4F5"
                             BorderBrush="#3F3F46"
                             BorderThickness="1"
                             Padding="8,6"
                             FontSize="13"
                             MaxLength="60"
                             KeyDown="FormNameTextBox_KeyDown"
                             IsVisibleChanged="FormNameTextBox_IsVisibleChanged" />

                    <!-- Error validation message below field -->
                    <TextBlock Text="{Binding FormError}"
                               Foreground="#F87171"
                               FontSize="11"
                               Margin="2,5,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasFormError, Converter={StaticResource BoolToVis}}" />

                    <!-- Form Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Batal (Esc)"
                                Command="{Binding CancelFormCommand}"
                                Style="{StaticResource SecondaryActionBtnStyle}"
                                Margin="0,0,8,0" />
                        <Button Content="Simpan (Enter)"
                                Command="{Binding SaveFormCommand}"
                                Style="{StaticResource PrimaryActionBtnStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. WORKSPACES LIST (Active when not in form, not in detail, and has items) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          MaxHeight="380"
                          Visibility="{Binding IsDetailViewActive, Converter={StaticResource InverseBoolToVis}}">
                <Grid>
                    <!-- Empty State -->
                    <Border Background="#1C1C21"
                            BorderBrush="#2E2E38"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="28"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding EmptyTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#E4E4E7"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EmptyDescription}"
                                       FontSize="12"
                                       Foreground="#71717A"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,6,0,16"
                                       MaxWidth="320"
                                       HorizontalAlignment="Center" />
                            <Button Content="{Binding CreateFirstButtonText}"
                                    Command="{Binding BeginCreateCommand}"
                                    Style="{StaticResource PrimaryActionBtnStyle}"
                                    HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- List of Workspaces -->
                    <ItemsControl ItemsSource="{Binding Workspaces}"
                                  Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WorkspaceItemViewModel}">
                                <Border Background="#1F1F24"
                                        BorderBrush="#2E2E38"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,8"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="WorkspaceCard_MouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#27272F" />
                                                    <Setter Property="BorderBrush" Value="#4B5563" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu Background="#18181B" BorderBrush="#3F3F46" Foreground="#F4F4F5">
                                            <MenuItem Header="Buka" Command="{Binding OpenCommand}" />
                                            <MenuItem Header="Ganti Nama (F2)" Command="{Binding RenameCommand}" />
                                            <Separator Background="#27272A" />
                                            <MenuItem Header="Hapus" Command="{Binding DeleteCommand}" Foreground="#F87171" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Folder Icon -->
                                        <TextBlock Grid.Column="0" Text="📁" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <!-- Workspace Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F4F4F5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ResourceCountText}"
                                                       FontSize="11"
                                                       Foreground="#71717A"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Action Buttons on Card -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="✏"
                                                    ToolTip="Ganti Nama (F2)"
                                                    Command="{Binding RenameCommand}"
                                                    Background="Transparent"
                                                    Foreground="#A1A1AA"
                                                    BorderThickness="0"
                                                    Padding="6,4"
                                                    Cursor="Hand"
                                                    Margin="0,0,2,0" />
                                            <Button Content="🗑"
                                                    ToolTip="Hapus Workspace"
                                                    Command="{Binding DeleteCommand}"
                                                    Background="Transparent"
                                                    Foreground="#F87171"
                                                    BorderThickness="0"
                                                    Padding="6,4"
                                                    Cursor="Hand" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- 3. DETAIL VIEW (Active when viewing a workspace and not in form) -->
            <Border Background="#1C1C21"
                    BorderBrush="#2E2E38"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="28"
                    MinHeight="180"
                    Visibility="{Binding IsDetailViewActive, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding DetailPlaceholderText}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="#A1A1AA"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding DetailPlaceholderSubtext}"
                               FontSize="11"
                               Foreground="#71717A"
                               Margin="0,4,0,14"
                               HorizontalAlignment="Center" />
                    <Border Background="#27272A"
                            BorderBrush="#3F3F46"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,3"
                            HorizontalAlignment="Center">
                        <TextBlock Text="Modul M03: Resource Management"
                                   FontSize="11"
                                   Foreground="#60A5FA"
                                   FontWeight="Medium" />
                    </Border>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
