<UserControl x:Class="AdaraBox.App.Views.Panels.WorkspacePanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AdaraBox.App.ViewModels"
             xmlns:conv="clr-namespace:AdaraBox.App.Converters"
             d:DataContext="{d:DesignInstance vm:WorkspacePanelViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="420" d:DesignWidth="460">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />

        <!-- Base Primary Button Style -->
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8" />
                                <Setter Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F3F46" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Destructive Button Style -->
        <Style x:Key="DestructiveActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#3F1D1D" />
            <Setter Property="Foreground" Value="#F87171" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#7F1D1D" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#991B1B" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="BorderBrush" Value="#DC2626" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent (Emerald) Button Style (Open Action) -->
        <Style x:Key="AccentActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#10B981" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#047857" />
                                <Setter Property="BorderBrush" Value="#34D399" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="#71717A" />
                                <Setter Property="BorderBrush" Value="#3F3F46" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Open the File Toggle Button Style -->
        <Style x:Key="OpenTheFileToggleBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F3F46" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsOpenMode}" Value="True">
                                <Setter Property="Background" Value="#064E3B" />
                                <Setter Property="Foreground" Value="#A7F3D0" />
                                <Setter Property="BorderBrush" Value="#10B981" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14" MinWidth="430">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- 1. HEADER ROW                              -->
        <!-- ========================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <!-- Normal List Header (When NOT in detail view) -->
            <Grid Visibility="{Binding IsDetailViewActive, Converter={StaticResource InverseBoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📁" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Workspace" FontSize="14" FontWeight="SemiBold" Foreground="#F4F4F5" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Buat Workspace"
                        Command="{Binding BeginCreateCommand}"
                        Style="{StaticResource PrimaryActionBtnStyle}"
                        Visibility="{Binding IsFormOpen, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>

            <!-- Detail View Header (When viewing a specific workspace) -->
            <Grid Visibility="{Binding IsDetailViewActive, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button Grid.Column="0"
                        Content="← Kembali"
                        Command="{Binding BackToListCommand}"
                        Style="{StaticResource SecondaryActionBtnStyle}"
                        Margin="0,0,10,0" />

                <!-- Detail Title & Resource count -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DetailTitle}" FontSize="14" FontWeight="Bold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DetailResourceCountText}" FontSize="11" Foreground="#71717A" Margin="0,1,0,0" />
                </StackPanel>

                <!-- Header Actions: Open the File Toggle, View Mode Toggle, Rename & Delete Workspace -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsFormOpen, Converter={StaticResource InverseBoolToVis}}">
                    <!-- Toggle Open the File Mode (FR-OF-01) -->
                    <Button Content="Open the File"
                            Command="{Binding ToggleOpenModeCommand}"
                            Style="{StaticResource OpenTheFileToggleBtnStyle}"
                            ToolTip="Pilih beberapa resource untuk dibuka sekaligus"
                            Margin="0,0,8,0" />

                    <!-- ViewMode Toggle: Grid vs List (FR-VW-01..05) -->
                    <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⊞ Grid"
                                    Command="{Binding ToggleViewModeCommand}"
                                    CommandParameter="Grid"
                                    Background="{Binding IsGridView, Converter={StaticResource BoolToVis}}"
                                    Foreground="{Binding IsGridView, Converter={StaticResource BoolToVis}}"
                                    Padding="6,3" FontSize="11" BorderThickness="0" Cursor="Hand" />
                            <Button Content="☰ List"
                                    Command="{Binding ToggleViewModeCommand}"
                                    CommandParameter="List"
                                    Background="{Binding IsListView, Converter={StaticResource BoolToVis}}"
                                    Foreground="{Binding IsListView, Converter={StaticResource BoolToVis}}"
                                    Padding="6,3" FontSize="11" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                    </Border>

                    <!-- Workspace Manage Actions (Hidden in Open Mode - FR-OF-05) -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding CanManageResources, Converter={StaticResource BoolToVis}}">
                        <Button Content="Ganti Nama"
                                Command="{Binding BeginRenameCommand}"
                                CommandParameter="{Binding SelectedWorkspace}"
                                Style="{StaticResource SecondaryActionBtnStyle}"
                                Margin="0,0,5,0" />
                        <Button Content="Hapus"
                                Command="{Binding DeleteWorkspaceCommand}"
                                CommandParameter="{Binding SelectedWorkspace}"
                                Style="{StaticResource DestructiveActionBtnStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- 2. CONTENT AREA (ROW 1)                    -->
        <!-- ========================================== -->
        <Grid Grid.Row="1">

            <!-- A. WORKSPACE INLINE FORM (Create / Rename Workspace) -->
            <Border Background="#202025"
                    BorderBrush="#3B82F6"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    VerticalAlignment="Top"
                    Panel.ZIndex="100"
                    Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5" Margin="0,0,0,10" />

                    <TextBox x:Name="FormNameTextBox"
                             Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                             Background="#18181B"
                             Foreground="#F4F4F5"
                             BorderBrush="#3F3F46"
                             BorderThickness="1"
                             Padding="8,6"
                             FontSize="13"
                             MaxLength="60"
                             KeyDown="FormNameTextBox_KeyDown"
                             IsVisibleChanged="FormNameTextBox_IsVisibleChanged" />

                    <TextBlock Text="{Binding FormError}"
                               Foreground="#F87171"
                               FontSize="11"
                               Margin="2,5,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasFormError, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Batal (Esc)" Command="{Binding CancelFormCommand}" Style="{StaticResource SecondaryActionBtnStyle}" Margin="0,0,8,0" />
                        <Button Content="Simpan (Enter)" Command="{Binding SaveFormCommand}" Style="{StaticResource PrimaryActionBtnStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- B. WORKSPACES LIST (When not in detail view) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          MaxHeight="380"
                          Visibility="{Binding IsWorkspaceListVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <!-- Empty State for Workspaces -->
                    <Border Background="#1C1C21"
                            BorderBrush="#2E2E38"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="28"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding EmptyTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#E4E4E7" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EmptyDescription}" FontSize="12" Foreground="#71717A" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,16" MaxWidth="320" HorizontalAlignment="Center" />
                            <Button Content="{Binding CreateFirstButtonText}" Command="{Binding BeginCreateCommand}" Style="{StaticResource PrimaryActionBtnStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Workspaces Cards -->
                    <ItemsControl ItemsSource="{Binding Workspaces}"
                                  Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WorkspaceItemViewModel}">
                                <Border Background="#1F1F24"
                                        BorderBrush="#2E2E38"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,10"
                                        Margin="0,0,0,8"
                                        Focusable="True"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="WorkspaceCard_MouseLeftButtonUp"
                                        KeyDown="WorkspaceCard_KeyDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#27272F" />
                                                    <Setter Property="BorderBrush" Value="#4B5563" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter Property="Background" Value="#27272F" />
                                                    <Setter Property="BorderBrush" Value="#3B82F6" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.ContextMenu>
                                        <ContextMenu Background="#18181B" BorderBrush="#3F3F46" Foreground="#F4F4F5">
                                            <MenuItem Header="Buka" Command="{Binding OpenCommand}" />
                                            <MenuItem Header="Ganti Nama" Command="{Binding RenameCommand}" />
                                            <Separator Background="#27272A" />
                                            <MenuItem Header="Hapus" Command="{Binding DeleteCommand}" Foreground="#F87171" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="📁" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ResourceCountText}" FontSize="11" Foreground="#71717A" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="✏" ToolTip="Ganti Nama" AutomationProperties.Name="Ganti Nama Workspace" Command="{Binding RenameCommand}" Background="Transparent" Foreground="#A1A1AA" BorderThickness="0" Padding="6,4" Cursor="Hand" Margin="0,0,2,0" />
                                            <Button Content="🗑" ToolTip="Hapus Workspace" AutomationProperties.Name="Hapus Workspace" Command="{Binding DeleteCommand}" Background="Transparent" Foreground="#F87171" BorderThickness="0" Padding="6,4" Cursor="Hand" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- C. WORKSPACE DETAIL VIEW (Resources Grid & List - M03) -->
            <Grid Visibility="{Binding IsWorkspaceDetailVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1. Resource Toolbar (Manage Mode - FR-OF-05) -->
                <Grid Grid.Row="0" Margin="0,0,0,10"
                      Visibility="{Binding CanManageResources, Converter={StaticResource BoolToVis}}">
                    <Grid Visibility="{Binding IsResourceFormOpen, Converter={StaticResource InverseBoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Add Resource Actions -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+ File" Command="{Binding AddFilesCommand}" Style="{StaticResource SecondaryActionBtnStyle}" ToolTip="Tambah satu atau beberapa file..." Margin="0,0,4,0" />
                            <Button Content="+ Folder" Command="{Binding AddFolderCommand}" Style="{StaticResource SecondaryActionBtnStyle}" ToolTip="Tambah folder..." Margin="0,0,4,0" />
                            <Button Content="+ Aplikasi" Command="{Binding AddApplicationCommand}" Style="{StaticResource SecondaryActionBtnStyle}" ToolTip="Tambah shortcut aplikasi (.exe, .lnk)..." Margin="0,0,4,0" />
                            <Button Content="+ Tautan" Command="{Binding BeginAddLinkCommand}" Style="{StaticResource SecondaryActionBtnStyle}" ToolTip="Tambah URL tautan web..." />
                        </StackPanel>

                        <!-- Recheck Availability Action -->
                        <Button Grid.Column="1"
                                Content="⟳ Cek Ulang"
                                Command="{Binding CheckAvailabilityCommand}"
                                Style="{StaticResource SecondaryActionBtnStyle}"
                                ToolTip="Cek ulang ketersediaan file/folder di disk" />
                    </Grid>
                </Grid>

                <!-- 2. Open the File Action Bar (Open Mode - FR-OF-02..10) -->
                <Border Grid.Row="0"
                        Background="#132E27"
                        BorderBrush="#10B981"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,6"
                        Margin="0,0,0,10"
                        Visibility="{Binding IsOpenMode, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Counter & Bulk Selection -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCountText}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#A7F3D0"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <Button Content="Pilih Semua"
                                    Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource SecondaryActionBtnStyle}"
                                    Padding="6,2"
                                    Margin="0,0,4,0" />

                            <Button Content="Bersihkan"
                                    Command="{Binding ClearSelectionCommand}"
                                    Style="{StaticResource SecondaryActionBtnStyle}"
                                    Padding="6,2" />
                        </StackPanel>

                        <!-- Center: Warning if > 10 items (FR-OF-10) -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ManySelectedWarningText}"
                                   FontSize="11"
                                   Foreground="#FBBF24"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="8,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasManySelected, Converter={StaticResource BoolToVis}}" />

                        <!-- Right: Open Button & Done -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding OpenButtonText}"
                                    Command="{Binding OpenSelectedCommand}"
                                    Style="{StaticResource AccentActionBtnStyle}"
                                    IsEnabled="{Binding CanOpen}"
                                    Margin="0,0,6,0" />

                            <Button Content="Selesai"
                                    Command="{Binding ExitOpenModeCommand}"
                                    Style="{StaticResource SecondaryActionBtnStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Resource Form (Add Link / Edit Resource) -->
                <Border Grid.Row="1"
                        Background="#202025"
                        BorderBrush="#3B82F6"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsResourceFormOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ResourceFormTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F5" Margin="0,0,0,10" />

                        <TextBlock Text="Target (Path atau URL):" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4" />
                        <TextBox x:Name="ResourceTargetTextBox"
                                 Text="{Binding ResourceFormTarget, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#18181B" Foreground="#F4F4F5" BorderBrush="#3F3F46" BorderThickness="1"
                                 Padding="8,6" FontSize="12" Margin="0,0,0,10"
                                 KeyDown="ResourceForm_KeyDown"
                                 IsVisibleChanged="ResourceTargetTextBox_IsVisibleChanged" />

                        <TextBlock Text="Nama Tampilan (Opsional jika ingin custom):" FontSize="11" Foreground="#A1A1AA" Margin="0,0,0,4" />
                        <TextBox x:Name="ResourceNameTextBox"
                                 Text="{Binding ResourceFormName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#18181B" Foreground="#F4F4F5" BorderBrush="#3F3F46" BorderThickness="1"
                                 Padding="8,6" FontSize="12" MaxLength="80"
                                 KeyDown="ResourceForm_KeyDown" />

                        <TextBlock Text="{Binding ResourceFormError}" Foreground="#F87171" FontSize="11" Margin="2,5,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasResourceFormError, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="Batal (Esc)" Command="{Binding CancelResourceFormCommand}" Style="{StaticResource SecondaryActionBtnStyle}" Margin="0,0,8,0" />
                            <Button Content="Simpan (Enter)" Command="{Binding SaveResourceFormCommand}" Style="{StaticResource PrimaryActionBtnStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. Launch Summary Dialog / Overlay (M04) -->
                <Border Grid.Row="1"
                        Background="#1E1E24"
                        BorderBrush="#10B981"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        VerticalAlignment="Top"
                        Panel.ZIndex="100"
                        Visibility="{Binding IsLaunchSummaryOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚀" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LaunchSummaryTitle}" FontSize="13" FontWeight="Bold" Foreground="#F4F4F5" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="✕"
                                    AutomationProperties.Name="Tutup Ringkasan"
                                    Command="{Binding CloseLaunchSummaryCommand}"
                                    Background="Transparent"
                                    Foreground="#A1A1AA"
                                    BorderThickness="0"
                                    FontSize="14"
                                    Cursor="Hand"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- Summary Message -->
                        <Border Background="#27272A" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                            <TextBlock Text="{Binding LaunchSummaryMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#F4F4F5" />
                        </Border>

                        <!-- Failed Items List (if any) -->
                        <StackPanel Visibility="{Binding HasFailedResults, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <TextBlock Text="Item yang Gagal Dibuka:" FontSize="11" FontWeight="SemiBold" Foreground="#F87171" Margin="0,0,0,6" />
                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FailedResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LaunchResultItemViewModel}">
                                            <Border Background="#2B1D1D" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#7F1D1D" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding ReasonBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#FEE2E2" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Footer Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Content="Coba Lagi yang Gagal"
                                    Command="{Binding RetryFailedCommand}"
                                    Style="{StaticResource PrimaryActionBtnStyle}"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding HasFailedResults, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Tutup"
                                    Command="{Binding CloseLaunchSummaryCommand}"
                                    Style="{StaticResource SecondaryActionBtnStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 4. Resources Container (When resource form and launch summary are closed) -->
                <Grid Grid.Row="1" Visibility="{Binding IsResourceFormOpen, Converter={StaticResource InverseBoolToVis}}">

                    <!-- Empty Resources State -->
                    <Border Background="#1C1C21"
                            BorderBrush="#2E2E38"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="28"
                            Visibility="{Binding IsResourcesEmpty, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding ResourceEmptyTitle}" FontSize="13" FontWeight="SemiBold" Foreground="#E4E4E7" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ResourceEmptyDescription}" FontSize="11" Foreground="#71717A" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,16" MaxWidth="320" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="+ File" Command="{Binding AddFilesCommand}" Style="{StaticResource SecondaryActionBtnStyle}" Margin="0,0,6,0" />
                                <Button Content="+ Folder" Command="{Binding AddFolderCommand}" Style="{StaticResource SecondaryActionBtnStyle}" Margin="0,0,6,0" />
                                <Button Content="+ Aplikasi" Command="{Binding AddApplicationCommand}" Style="{StaticResource SecondaryActionBtnStyle}" Margin="0,0,6,0" />
                                <Button Content="+ Tautan" Command="{Binding BeginAddLinkCommand}" Style="{StaticResource SecondaryActionBtnStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- MODE 1: GRID VIEW (FR-VW-01, FR-VW-03, FR-VW-05, FR-OF-02) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="360"
                                  Visibility="{Binding IsGridView, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Resources}"
                                      Visibility="{Binding HasResources, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ResourceItemViewModel}">
                                    <Border Width="130" Height="110"
                                            Background="#1F1F24"
                                            BorderBrush="#2E2E38"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8"
                                            Margin="0,0,8,8"
                                            ToolTip="{Binding FullTooltip}"
                                            Focusable="True"
                                            MouseLeftButtonUp="ResourceCard_MouseLeftButtonUp"
                                            KeyDown="ResourceCard_KeyDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#27272F" />
                                                        <Setter Property="BorderBrush" Value="#4B5563" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter Property="Background" Value="#27272F" />
                                                        <Setter Property="BorderBrush" Value="#3B82F6" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#132E27" />
                                                        <Setter Property="BorderBrush" Value="#10B981" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ContextMenu>
                                            <ContextMenu Background="#18181B" BorderBrush="#3F3F46" Foreground="#F4F4F5">
                                                <MenuItem Header="Edit" Command="{Binding EditCommand}" />
                                                <MenuItem Header="Pindah ke Atas" Command="{Binding MoveUpCommand}" />
                                                <MenuItem Header="Pindah ke Bawah" Command="{Binding MoveDownCommand}" />
                                                <Separator Background="#27272A" />
                                                <MenuItem Header="Hapus dari Workspace" Command="{Binding DeleteCommand}" Foreground="#F87171" />
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Top: CheckBox + Icon + Availability Badge -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- CheckBox in Open Mode (FR-OF-02) -->
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsSelected}"
                                                          Visibility="{Binding IsOpenMode, Converter={StaticResource BoolToVis}}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,4,0" />

                                                <Image Grid.Column="1" Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Center" />

                                                <!-- Warning Badge (⚠️) if Missing or AccessDenied -->
                                                <TextBlock Grid.Column="2"
                                                           Text="⚠️"
                                                           FontSize="12"
                                                           Foreground="#EF4444"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top"
                                                           ToolTip="{Binding AvailabilityWarningText}"
                                                           Visibility="{Binding HasAvailabilityWarning, Converter={StaticResource BoolToVis}}" />
                                            </Grid>

                                            <!-- Middle: Resource Name (max 2 lines) -->
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Name}"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="#F4F4F5"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="32"
                                                       Margin="0,4,0,0" />

                                            <!-- Bottom: Distinctive info (host / short path) -->
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding DistinctiveInfo}"
                                                       FontSize="10"
                                                       Foreground="#71717A"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- MODE 2: LIST VIEW (FR-VW-02, FR-VW-03, FR-VW-05, FR-OF-02) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="360"
                                  Visibility="{Binding IsListView, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Resources}"
                                      Visibility="{Binding HasResources, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ResourceItemViewModel}">
                                    <Border Background="#1F1F24"
                                            BorderBrush="#2E2E38"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="10,6"
                                            Margin="0,0,0,6"
                                            ToolTip="{Binding FullTooltip}"
                                            Focusable="True"
                                            MouseLeftButtonUp="ResourceCard_MouseLeftButtonUp"
                                            KeyDown="ResourceCard_KeyDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#27272F" />
                                                        <Setter Property="BorderBrush" Value="#4B5563" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter Property="Background" Value="#27272F" />
                                                        <Setter Property="BorderBrush" Value="#3B82F6" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#132E27" />
                                                        <Setter Property="BorderBrush" Value="#10B981" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.ContextMenu>
                                            <ContextMenu Background="#18181B" BorderBrush="#3F3F46" Foreground="#F4F4F5">
                                                <MenuItem Header="Edit" Command="{Binding EditCommand}" />
                                                <MenuItem Header="Pindah ke Atas" Command="{Binding MoveUpCommand}" />
                                                <MenuItem Header="Pindah ke Bawah" Command="{Binding MoveDownCommand}" />
                                                <Separator Background="#27272A" />
                                                <MenuItem Header="Hapus dari Workspace" Command="{Binding DeleteCommand}" Foreground="#F87171" />
                                            </ContextMenu>
                                        </Border.ContextMenu>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- CheckBox in Open Mode (FR-OF-02) -->
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected}"
                                                      Visibility="{Binding IsOpenMode, Converter={StaticResource BoolToVis}}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />

                                            <!-- Left: Icon + Warning -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center" />
                                                <TextBlock Text="⚠️"
                                                           FontSize="11"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding AvailabilityWarningText}"
                                                           Visibility="{Binding HasAvailabilityWarning, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <!-- Middle: Name & Path info -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DistinctiveInfo}" FontSize="10" Foreground="#71717A" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Type Tag -->
                                            <Border Grid.Column="3"
                                                    Background="#27272A"
                                                    BorderBrush="#3F3F46"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="5,2"
                                                    Margin="6,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeDisplayName}" FontSize="10" Foreground="#A1A1AA" />
                                            </Border>

                                            <!-- Action Buttons: Move Up/Down, Edit, Delete (FR-OF-05: Hidden in Open Mode) -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}">
                                                <Button Content="▲" ToolTip="Pindah ke Atas" AutomationProperties.Name="Pindah ke Atas" Command="{Binding MoveUpCommand}" Background="Transparent" Foreground="#A1A1AA" BorderThickness="0" Padding="4,2" Cursor="Hand" />
                                                <Button Content="▼" ToolTip="Pindah ke Bawah" AutomationProperties.Name="Pindah ke Bawah" Command="{Binding MoveDownCommand}" Background="Transparent" Foreground="#A1A1AA" BorderThickness="0" Padding="4,2" Cursor="Hand" />
                                                <Button Content="✏" ToolTip="Edit" AutomationProperties.Name="Edit Resource" Command="{Binding EditCommand}" Background="Transparent" Foreground="#A1A1AA" BorderThickness="0" Padding="4,2" Cursor="Hand" Margin="2,0" />
                                                <Button Content="🗑" ToolTip="Hapus dari Workspace" AutomationProperties.Name="Hapus Resource" Command="{Binding DeleteCommand}" Background="Transparent" Foreground="#F87171" BorderThickness="0" Padding="4,2" Cursor="Hand" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </Grid>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
