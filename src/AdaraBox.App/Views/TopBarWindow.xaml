<Window x:Class="AdaraBox.App.Views.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AdaraBox.App.ViewModels"
        xmlns:panels="clr-namespace:AdaraBox.App.Views.Panels"
        d:DataContext="{d:DesignInstance vm:TopBarViewModel}"
        mc:Ignorable="d"
        Title="Adara Box"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Background="Transparent"
        SizeToContent="Height"
        Width="480">

    <Window.Resources>
        <!-- DataTemplates for Module Panels -->
        <DataTemplate DataType="{x:Type vm:WorkspacePanelViewModel}">
            <panels:WorkspacePanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MediaPanelViewModel}">
            <panels:MediaPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsPanelViewModel}">
            <panels:StatsPanelView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPanelViewModel}">
            <panels:SettingsPanelView />
        </DataTemplate>

        <!-- Module Button Style -->
        <Style x:Key="ModuleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3F3F46" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder"
            Background="#EE18181B"
            BorderBrush="#3F3F46"
            BorderThickness="1,0,1,1"
            CornerRadius="0,0,10,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.45" Direction="270" Color="#000000" />
        </Border.Effect>

        <StackPanel>
            <!-- Top Bar Header Row (Always 36 DIP) -->
            <Grid Height="36" Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="✦" Foreground="#3B82F6" FontWeight="Bold" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Adara Box" Foreground="#F4F4F5" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Data-driven Module Buttons (ordered by Order) -->
                <ItemsControl x:Name="ModulesItemsControl" Grid.Column="1" ItemsSource="{Binding Modules}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayName}"
                                    Style="{StaticResource ModuleButtonStyle}"
                                    Click="ModuleButton_Click"
                                    Tag="{Binding}">
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Close Panel Button (✕) -->
                <Button x:Name="ClosePanelButton"
                        Grid.Column="2"
                        Content="✕"
                        Width="24" Height="22"
                        Background="Transparent"
                        Foreground="#A1A1AA"
                        BorderThickness="0"
                        FontSize="11"
                        Cursor="Hand"
                        ToolTip="Tutup panel (Esc)"
                        Click="ClosePanelButton_Click"
                        Visibility="Collapsed" />
            </Grid>

            <!-- Panel Content Area (Visible only when a module is selected) -->
            <Border x:Name="PanelContainer"
                    BorderBrush="#27272A"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed"
                    MaxHeight="600">
                <ContentControl Content="{Binding ActivePanelViewModel}" />
            </Border>
        </StackPanel>
    </Border>
</Window>
