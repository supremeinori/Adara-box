<UserControl x:Class="AdaraBox.App.Views.Components.ModuleStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="360">
    <Border x:Name="RootBorder" 
            CornerRadius="8" 
            BorderThickness="1" 
            Padding="16" 
            Margin="8"
            Background="#27272A"
            BorderBrush="#3F3F46">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Status Badge -->
            <Border x:Name="BadgeBorder" 
                    CornerRadius="12" 
                    Padding="10,4" 
                    HorizontalAlignment="Center" 
                    BorderThickness="1"
                    Background="#3B2E05" 
                    BorderBrush="#D97706">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusBadgeIcon" Text="🛠" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusBadgeText" Text="Masih dalam pengembangan" FontSize="11" FontWeight="SemiBold" Foreground="#FBBF24" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Detailed Message (if any) -->
            <TextBlock x:Name="DetailMessageText" 
                       Margin="0,10,0,0" 
                       TextAlignment="Center" 
                       FontSize="12" 
                       Foreground="#A1A1AA" 
                       TextWrapping="Wrap" 
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
