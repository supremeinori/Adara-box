<Window x:Class="AdaraBox.WindowSpike.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adara Box - Top Bar Spike"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Background="#EE24292E"
        Height="36"
        Width="640">
    <Border BorderBrush="#444D56" BorderThickness="1" CornerRadius="0,0,8,8">
        <Grid VerticalAlignment="Center" Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Adara Box (Spike)" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Input Test:" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                <TextBox x:Name="TestTextBox" Width="180" Height="22" Background="#1B1F23" Foreground="White" BorderBrush="#586069" VerticalContentAlignment="Center" Padding="4,0" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Grid.Column="2" Text="Overlay Mode" Foreground="#34D399" VerticalAlignment="Center" Margin="10,0" FontSize="11" />

            <Button Grid.Column="3" Content="✕" Width="24" Height="22" Background="Transparent" Foreground="White" BorderThickness="0" Click="CloseButton_Click" Cursor="Hand" />
        </Grid>
    </Border>
</Window>
